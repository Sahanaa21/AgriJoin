# ============================================================
# AgriJoin — Environment variable template
# Copy this file to `.env` (git-ignored) and fill in real values.
# NEVER commit a filled-in .env. NEVER put the service-role key
# in the web or mobile app.
# ============================================================

# ---- Supabase project (shared) ----
# Project URL is public and safe to expose.
SUPABASE_URL=https://ecyugokcecwhwtiqxfnl.supabase.co

# Public anon key — safe for browser/mobile ONLY because Row Level
# Security protects the data. Get it from:
# Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon public
SUPABASE_ANON_KEY=your-anon-public-key-here

# ---- Web (Vite) ----
# Vite only exposes vars prefixed with VITE_ to the browser.
VITE_SUPABASE_URL=https://ecyugokcecwhwtiqxfnl.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
# Optional: base URL of the thin Express API (leave blank to use Supabase directly).
VITE_API_URL=

# ---- Mobile (Expo) ----
# Expo only exposes vars prefixed with EXPO_PUBLIC_ to the app.
EXPO_PUBLIC_SUPABASE_URL=https://ecyugokcecwhwtiqxfnl.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
EXPO_PUBLIC_API_URL=

# ---- Express API (server-side only, NEVER shipped to clients) ----
# Service-role key bypasses RLS. Keep it server-side only.
# Supabase Dashboard -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
API_PORT=4000
# Comma-separated list of origins allowed to call the API.
API_CORS_ORIGINS=http://localhost:5173

# ---- Supabase CLI (local migrations/seed; optional) ----
# Database connection string for `supabase db push` / psql.
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.ecyugokcecwhwtiqxfnl.supabase.co:5432/postgres
